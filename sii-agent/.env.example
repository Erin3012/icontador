# Copia este archivo como sii-agent/.env en TU PC. No guardes aquí credenciales del SII.

# Dirección de Cifrax (sin barra final).
SII_URL_SERVIDOR=https://qlc.cl

# Token propio de este PC. Se completa al emparejarlo desde Cifrax.
SII_TOKEN_AGENTE=
# Código de un solo uso generado desde Cifrax para emparejar este PC (vence en 10 minutos).
# SII_CODIGO_EMPAREJAMIENTO=ABCDE-FGHJK

# Opcionales
# SII_HEADLESS=true
# SII_CANAL=chrome           # usa Chrome instalado en el PC en vez de Chromium de Playwright
# SII_INTERVALO_SEG=60       # cada cuántos segundos revisar si hay tareas nuevas
# SII_CARPETA=descargas      # dónde se guardan los CSV temporales (relativo a sii-agent/)
# SII_CONSERVAR=false        # true para no borrar los CSV después de importarlos
