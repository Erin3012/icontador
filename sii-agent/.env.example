# Copia este archivo como sii-agent/.env en TU PC. El .env no se sube a git. La clave tributaria se guarda en Cifrax, no aquí.

# Dirección de Cifrax (sin barra final).
SII_URL_SERVIDOR=https://qlc.cl

# Token secreto del agente. Debe ser igual a sii_agente_token en api/config.php del servidor.
SII_TOKEN_AGENTE=cambia-por-el-mismo-token-del-servidor

# Opcional: claves tributarias por RUT (JSON; RUT con guion y sin puntos). Las claves guardadas en Cifrax tienen prioridad.
SII_CLAVES='{"76000000-0":"tu-clave-tributaria"}'

# Opcionales
# SII_HEADLESS=true
# SII_CANAL=chrome          # usa el Chrome instalado en tu PC en vez del Chromium de Playwright
# SII_HEADLESS=false        # false para ver la ventana del navegador (útil la primera vez o si el SII pide CAPTCHA)
# SII_INTERVALO_SEG=60       # cada cuántos segundos revisar si hay tareas nuevas
# SII_CARPETA=descargas      # dónde se guardan los CSV temporales (relativo a sii-agent/)
# SII_CONSERVAR=false        # true para no borrar los CSV después de importarlos
