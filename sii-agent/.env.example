# Copia este archivo como sii-agent/.env en TU PC. No guardes aquí credenciales del SII.

# Dirección de Cifrax (sin barra final).
SII_URL_SERVIDOR=https://qlc.cl

# Código de enrolamiento de un solo uso emitido por un administrador en qlc.cl (vence en 10 min).
# Windows: se elimina de este archivo al canjearlo y el token queda en Windows Credential Manager.
# Ubuntu: usa npm run enrolar:linux; guarda el token cifrado con systemd-creds.
# SII_CODIGO_SERVICIO=ABCDE-FGHJK-LMNPR-STUVW

# Opcionales
# SII_HEADLESS=true
# SII_CANAL=chrome           # usa Chrome instalado en el PC en vez de Chromium de Playwright
# SII_INTERVALO_SEG=30       # cada cuántos segundos revisar si hay tareas nuevas
# SII_CARPETA=descargas      # dónde se guardan los CSV temporales (relativo a sii-agent/)
# SII_CONSERVAR=false        # true para no borrar los CSV después de importarlos
